{
  "name": "openadvo",
  "version": "0.0.1",
  "private": true,
  "description": "Open Advocate: an agent-operated litigation workspace for Supreme Court Advocates-on-Record.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.15",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.15",
    "@astryxdesign/theme-neutral": "0.7.15",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@stylexjs/stylex": "0.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.22.0",
    "typebox": "1.3.27"
  }
}
